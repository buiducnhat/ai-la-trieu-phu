# ── Bí mật dùng để mã hóa token câu hỏi (đáp án không lộ ra trình duyệt).
# BẮT BUỘC ở production (Cloudflare Workers: mỗi isolate là một tiến trình riêng, token phải giải mã được ở mọi nơi):
#   wrangler secret put GAME_SECRET
# Dev/test: bỏ trống thì dùng khóa ngẫu nhiên theo tiến trình.
# File này dùng làm mẫu cho .dev.vars (local/preview) — xem README.
GAME_SECRET=

# ── Nguồn câu hỏi mặc định: bank | llm | mixed
# bank  = bộ câu hỏi công khai đóng gói sẵn (mặc định khi chưa cấu hình AI)
# llm   = AI tạo từng câu (lỗi thì tự dùng bộ có sẵn và báo cho người chơi)
# mixed = ngẫu nhiên xen kẽ (mặc định khi đã cấu hình AI)
# Người chơi vẫn đổi được trong màn hình Cài đặt.
QUESTION_SOURCE=

# ── Bộ câu hỏi công khai bổ sung từ internet (JSON, cách nhau bằng dấu phẩy hoặc khoảng trắng).
# Định dạng: mảng (hoặc {"questions":[...]}) các đối tượng
#   { "question": "...", "options": ["A","B","C","D"], "answer": "B" | 1, "level": 1..15 | "easy|medium|hard", "category"?: "...", "explanation"?: "..." }
# Xem src/data/bank/README.md. Ví dụ:
# QUESTION_BANK_URLS=https://raw.githubusercontent.com/you/repo/main/questions.json
QUESTION_BANK_URLS=

# ── AI tạo câu hỏi (máy chủ). Để trống toàn bộ nếu không dùng AI.
# LLM_PROVIDER: openai | anthropic | gemini | openrouter | groq | custom
#   custom = máy chủ tương thích OpenAI bất kỳ (Ollama, LM Studio, vLLM...) tại LLM_BASE_URL
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Chỉ cần với LLM_PROVIDER=custom (hoặc muốn ghi đè URL của nhà cung cấp). Ví dụ Ollama: http://localhost:11434/v1
LLM_BASE_URL=
# Giới hạn số lần gọi AI bằng khóa của máy chủ cho mỗi IP trong 10 phút.
LLM_RATE_LIMIT_PER_10_MIN=120
